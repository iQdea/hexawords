# Stage 1: Build
FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY packages/types/package.json packages/types/
COPY packages/hex-math/package.json packages/hex-math/
COPY packages/game-engine/package.json packages/game-engine/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile

COPY packages/ packages/
COPY apps/web/ apps/web/

RUN pnpm --filter @hexawords/types build && \
    pnpm --filter @hexawords/hex-math build && \
    pnpm --filter @hexawords/game-engine build && \
    pnpm --filter @hexawords/web build-only

# Stage 2: Serve with nginx
FROM nginx:alpine
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY nginx/spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
